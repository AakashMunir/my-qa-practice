name: Professional QA Pipeline

on:
  pull_request:
    branches: [ main, develop ]

jobs:

  ui-tests:                         # Step 2 — API pass hone ke baad
    needs: api-tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - run: pip install playwright pytest-playwright
      - run: playwright install chromium
        if: always()
        with:
          name: ui-allure-results
          path: allure-results/
